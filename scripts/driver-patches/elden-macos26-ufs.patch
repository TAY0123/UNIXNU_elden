+  gRootDiagnostic.smmuSlot = route.slot;
+  gRootDiagnostic.smr = route.smr;
+  gRootDiagnostic.s2cr = route.s2cr;
+  gRootDiagnostic.cbar = route.cbar;
+  gRootDiagnostic.cba2r = route.cba2r;
+  gRootDiagnostic.sctlr = route.sctlr;
+  if (route.error) return false;
+  report[0] = route.slot | (route.bank << 16);
+  report[1] = route.cbar;
+  report[2] = route.sctlr;

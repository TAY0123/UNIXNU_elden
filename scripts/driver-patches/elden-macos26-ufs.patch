+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#pragma once
+
+struct EldenUfsExtent {
+  uint64_t first;
+  uint64_t last;
+
+  bool valid (uint32_t lunLast) const
+  {
+    return first > 1 && first <= last && last < lunLast;
+  }
+
+  bool contains (uint64_t lba, uint32_t blocks) const
+  {
+    return blocks && first <= lba && lba <= last && blocks - 1 <= last - lba;
+  }
+};

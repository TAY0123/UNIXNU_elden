+// Admit only the DMA route already established by firmware.
+static bool checkEldenUfsDma (OSSharedPtr<IOMemoryMap> &keep, uint32_t *report,
+                             uint64_t dma, uint64_t bytes)
+{
+  uintptr_t smmu = mapPhys (ELDEN_UFS_SMMU, 0x100000, keep);
+  if (!smmu) return false;
+  auto route = eldenUfsIdentity (ELDEN_UFS_STREAM, dma, bytes,
+    [smmu](unsigned offset) { return read32 (smmu, offset); });
+  gRootDiagnostic.smmuId1 = route.id1;
+  gRootDiagnostic.smmuId2 = route.id2;
+  gRootDiagnostic.smmuSlot = route.slot;
+  gRootDiagnostic.smr = route.smr;
+  gRootDiagnostic.s2cr = route.s2cr;
+  gRootDiagnostic.cbar = route.cbar;
+  gRootDiagnostic.cba2r = route.cba2r;
+  gRootDiagnostic.sctlr = route.sctlr;
+  if (route.error) return false;
+  report[0] = route.slot | (route.bank << 16);
+  report[1] = route.cbar;
+  report[2] = route.sctlr;
+  return true;

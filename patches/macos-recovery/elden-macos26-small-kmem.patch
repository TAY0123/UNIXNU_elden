 	assert((total_claims & PAGE_MASK) == 0);
 
-
+	if (total_claims >= free_size) {
+		panic("kmem_range_init: fixed claims %#llx exhaust largest hole %#llx",
+		    total_claims, free_size);
+	}
 	free_size -= total_claims;
 

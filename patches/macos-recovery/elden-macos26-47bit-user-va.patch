diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 7306308..2f6528b 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -671,6 +671,18 @@ Lbootstrap_tables_exhausted:
 	// the early debugger rather than corrupting memory or forging a map.
 	b Lbootstrap_tables_exhausted
 Lbootstrap_tables_ready:
+#if SHENG_ARM64E_4K_USER_VA
+	/* The low V=P window and framebuffer both lie in L0 entry 0. */
+	SHENG_EARLY_ADDRESS x0, EXT(sheng_bootstrap_user_l0)
+	mov		x1, x0
+	mov		x2, #(PGBYTES / 16)
+1:
+	stp		xzr, xzr, [x1], #16
+	subs		x2, x2, #1
+	b.ne		1b
+	orr		x1, x25, #(ARM_TTE_BOOT_TABLE)
+	str		x1, [x0]
+#endif
 	/* Ensure TTEs are visible */
 	dsb		ish
 
@@ -711,15 +723,19 @@ common_start:
 
 
 	/* Set up translation table base registers.
-	 *	TTBR0 - V=P table @ top of kernel
-	 *	TTBR1 - KVA table @ top of kernel + 1 page
+	 *	TTBR0 - V=P table, through an L0 root for 47-bit 4 KiB user translation
+	 *	TTBR1 - KVA L1 table @ bootstrap_pagetables + 1 page
 	 */
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR) || defined(KERNEL_INTEGRITY_PV_CTRR)
 	/* Note that for KTRR configurations, the V=P map will be modified by
 	 * arm_vm_init.c.
 	 */
 #endif
+#if SHENG_ARM64E_4K_USER_VA
+	SHENG_EARLY_ADDRESS x0, EXT(sheng_bootstrap_user_l0)
+#else
 	and		x0, x25, #(TTBR_BADDR_MASK)
+#endif
 	mov		x19, lr
 	bl		EXT(set_mmu_ttb)
 	mov		lr, x19

diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1415,6 +1415,11 @@ int
 ml_get_cpu_number(uint32_t phys_id)
 {
+#if SHENG
+	/* SM8750 has cores with the same Aff0/Aff1 in different Aff2 groups. */
+	phys_id &= MPIDR_AFF2_MASK | MPIDR_AFF1_MASK | MPIDR_AFF0_MASK;
+#else
 	phys_id &= MPIDR_AFF1_MASK | MPIDR_AFF0_MASK;
+#endif
 
 	for (unsigned i = 0; i < topology_info.num_cpus; i++) {
 		if (topology_info.cpus[i].phys_id == phys_id) {
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -151,7 +151,9 @@
 	adrp	x19, EXT(ResetHandlerData)@page			// Get address of the reset handler data
 	add		x19, x19, EXT(ResetHandlerData)@pageoff
 	mrs		x15, MPIDR_EL1						// Load MPIDR to get CPU number
-#if HAS_CLUSTER || SHENG
+#if SHENG
+	and		x0, x15, #0xFFFFFF					// Elden distinguishes cores in Affinity2
+#elif HAS_CLUSTER
 	and		x0, x15, #0xFFFF					// CPU number in Affinity0, cluster ID in Affinity1
 #else
 	and		x0, x15, #0xFF						// CPU number is in MPIDR Affinity Level 0

+def elden_profile(board: Path) -> str:
+    fields = ('base', 'aperture', 'width', 'height', 'width_mm', 'height_mm')
+    table = tomllib.loads(board.read_text())['board']
+    profile = table['hardware']['gop_framebuffer']
+    values = [profile[name] for name in fields]
+    if any(type(value) is not int or value <= 0 for value in values):
+        raise ValueError('Elden GOP profile requires positive integer fields')
+    base, aperture, width, height, width_mm, height_mm = values
+    if (table['name'] != 'elden' or profile['pixel_format'] != 'a8r8g8b8'
+            or base % 16384 or aperture % 16384 or base + aperture > 1 << 64
+            or width > 16384 or height > 16384 or width * height * 4 > aperture
+            or width_mm > 1000 or height_mm > 1000):
+        raise ValueError('invalid Elden GOP framebuffer profile')
+    members = '\n'.join(f'    uint64_t {field};' for field in fields)
+    initializers = ', '.join(f'{value}ULL' for value in values)
+    return ('// Generated from the device board description.\n#pragma once\n'
+            f'struct EldenGopProfile {{\n{members}\n}};\n'
+            f'constexpr EldenGopProfile kEldenGop = {{{initializers}}};\n')

-/* One read covers 64 original signing blocks. */
 #define CS_NATIVE4K_CHUNK       (1024 * 1024)
 #define CS_NATIVE4K_REPORT_MIN  (32 * 1024 * 1024)
+#define CS_NATIVE4K_BLOCK       (16 * 1024)
+#define CS_NATIVE4K_WORKERS     4
+
+extern kern_return_t thread_terminate(thread_t);
+
+static LCK_GRP_DECLARE(cs_native4k_lock_group, "native 4K signature verification");
+/* Concurrent registrations can fall back to the serial path. */
+static bool cs_native4k_pool_busy;
+
+static int
+cs_native4k_hash_range(const struct cs_blob *blob, const uint8_t *data,
+    uint64_t offset, size_t length, vm_offset_t storage)
+{
+	const CS_CodeDirectory *cd = blob->csb_cd;
+	const struct cs_hash *md = blob->csb_hashtype;
+	const char *lower = blob->csb_mem_kaddr;
+	const char *upper = lower + blob->csb_mem_size;
+	unsigned long verified = 0;
+	int error = 0;
+
+	for (size_t block = 0; block < length; block += CS_NATIVE4K_BLOCK) {
+		union cs_hash_union ctx;
+		uint8_t digest[CS_HASH_MAX_SIZE];
+		const uint64_t position = offset + block;
+		const size_t bytes = MIN((size_t)CS_NATIVE4K_BLOCK, length - block);
+		const uint8_t *expected = hashes(cd, (uint32_t)(position >> 14),
+		    md->cs_size, lower, upper);
+		if (expected == NULL) {
+			error = EBADEXEC;
+			break;
+		}
+		md->cs_init(&ctx);
+		md->cs_update(&ctx, data + block, bytes);
+		md->cs_final(digest, &ctx);
+		if (bcmp(expected, digest, md->cs_size)) {
+			os_atomic_inc(&cs_validate_page_bad_hash, relaxed);
+			error = EBADEXEC;
+			break;
+		}
+		verified++;
+		for (size_t sub = 0; sub < bytes; sub += PAGE_SIZE) {
+			const size_t page_bytes = MIN((size_t)PAGE_SIZE, bytes - sub);
+			const vm_size_t index = (position + sub) >> PAGE_SHIFT;
+			md->cs_init(&ctx);
+			md->cs_update(&ctx, data + block + sub, page_bytes);
+			md->cs_final(digest, &ctx);
+			memcpy((void *)(storage + index * md->cs_size), digest, md->cs_size);
+		}
+	}
+	os_atomic_add(&cs_native4k_full_blocks, verified, relaxed);
+	return error;
+}
+
+struct cs_native4k_pool {
+	lck_mtx_t lock;
+	const struct cs_blob *blob;
+	vm_offset_t storage;
+	const uint8_t *buffer;
+	uint64_t offset;
+	size_t length;
+	size_t stride;
+	size_t next;
+	unsigned workers;
+	unsigned pending;
+	bool stopping;
+	int error;
+	uint64_t hash_ticks;
+};
+
+static void
+cs_native4k_worker(void *argument, wait_result_t result __unused)
+{
+	struct cs_native4k_pool *pool = argument;
+	lck_mtx_lock(&pool->lock);
+	for (;;) {
+		while (pool->next >= pool->length && !pool->stopping) {
+			lck_mtx_sleep(&pool->lock, LCK_SLEEP_DEFAULT,
+			    (event_t)&pool->next, THREAD_UNINT);
+		}
+		if (pool->stopping) {
+			break;
+		}
+		const size_t start = pool->next;
+		const size_t length = MIN(pool->stride, pool->length - start);
+		pool->next += length;
+		lck_mtx_unlock(&pool->lock);
+
+		const uint64_t start_ticks = mach_absolute_time();
+		const int error = cs_native4k_hash_range(pool->blob, pool->buffer + start,
+		    pool->offset + start, length, pool->storage);
+		const uint64_t ticks = mach_absolute_time() - start_ticks;
+
+		lck_mtx_lock(&pool->lock);
+		pool->hash_ticks += ticks;
+		if (error) {
+			pool->error = error;
+		}
+		if (--pool->pending == 0) {
+			thread_wakeup((event_t)&pool->pending);
+		}
+	}
+	if (--pool->workers == 0) {
+		thread_wakeup((event_t)&pool->workers);
+	}
+	lck_mtx_unlock(&pool->lock);
+	thread_terminate(current_thread());
+}
+
+static void
+cs_native4k_pool_start(struct cs_native4k_pool *pool, const struct cs_blob *blob,
+    vm_offset_t storage)
+{
+	unsigned cpus = 0;
+	for (cluster_type_t type = CLUSTER_TYPE_SMP; type < MAX_CPU_TYPES; type++) {
+		cpus += ml_get_cpu_number_type(type, true, true);
+	}
+	if (cpus < 2 || !os_atomic_cmpxchg(&cs_native4k_pool_busy, false, true, acquire)) {
+		return;
+	}
+	lck_mtx_init(&pool->lock, &cs_native4k_lock_group, LCK_ATTR_NULL);
+	pool->blob = blob;
+	pool->storage = storage;
+	const unsigned target = MIN(cpus - 1, CS_NATIVE4K_WORKERS);
+	for (; pool->workers < target; pool->workers++) {
+		thread_t worker;
+		if (kernel_thread_start(cs_native4k_worker, pool, &worker) != KERN_SUCCESS) {
+			break;
+		}
+		thread_deallocate(worker);
+	}
+	if (!pool->workers) {
+		lck_mtx_destroy(&pool->lock, &cs_native4k_lock_group);
+		os_atomic_store(&cs_native4k_pool_busy, false, release);
+	}
+}
+
+static void
+cs_native4k_pool_submit(struct cs_native4k_pool *pool, const uint8_t *buffer,
+    uint64_t offset, size_t length)
+{
+	const size_t blocks = howmany(length, CS_NATIVE4K_BLOCK);
+	const size_t stride = howmany(blocks, pool->workers) * CS_NATIVE4K_BLOCK;
+
+	lck_mtx_lock(&pool->lock);
+	pool->buffer = buffer;
+	pool->offset = offset;
+	pool->length = length;
+	pool->stride = stride;
+	pool->next = 0;
+	pool->pending = (unsigned)howmany(length, stride);
+	thread_wakeup((event_t)&pool->next);
+	lck_mtx_unlock(&pool->lock);
+}
+
+static int
+cs_native4k_pool_wait(struct cs_native4k_pool *pool, uint64_t *hash_ticks)
+{
+	lck_mtx_lock(&pool->lock);
+	while (pool->pending) {
+		lck_mtx_sleep(&pool->lock, LCK_SLEEP_DEFAULT, (event_t)&pool->pending, THREAD_UNINT);
+	}
+	const int error = pool->error;
+	*hash_ticks = pool->hash_ticks;
+	lck_mtx_unlock(&pool->lock);
+	return error;
+}
+
+static void
+cs_native4k_pool_stop(struct cs_native4k_pool *pool)
+{
+	lck_mtx_lock(&pool->lock);
+	pool->stopping = true;
+	thread_wakeup((event_t)&pool->next);
+	while (pool->workers) {
+		lck_mtx_sleep(&pool->lock, LCK_SLEEP_DEFAULT, (event_t)&pool->workers, THREAD_UNINT);
+	}
+	lck_mtx_unlock(&pool->lock);
+	lck_mtx_destroy(&pool->lock, &cs_native4k_lock_group);
+	os_atomic_store(&cs_native4k_pool_busy, false, release);
+}
 

+			char message[128];
+			size_t copied = 0;
+			static const char prefix[] = "Unimplemented pixel format of ";
+			int error = copyin(0x1ae74a558ULL + slide, &annotation, sizeof(annotation));
+			if (!error) {
+				error = copyinstr(annotation, message, sizeof(message), &copied);
+			}
+			if (!error && !strncmp(message, prefix, sizeof(prefix) - 1)) {
+				printf("ELDEN-WS-FORMAT: %s\n", message);
+			} else {

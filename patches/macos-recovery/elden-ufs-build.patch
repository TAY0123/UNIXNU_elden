+def stage_elden_ufs(device: Path, upstream: Path, destination: Path) -> tuple[Path, dict]:
+    board = tomllib.loads((device / 'board.toml').read_text())['board']
+    hardware = board['hardware']
+    handoff = hardware['ufs_handoff']
+    install = hardware['ufs_install']
+    first, last = (install[name] for name in ('first_lba', 'last_lba'))
+    if type(first) is not int or type(last) is not int or not 1 < first <= last < (1 << 32) - 1:
+        raise ValueError('invalid Elden install extent')
+    host = int(hardware['ufs_host'], 0)
+    gcc, smmu, stream = (handoff[name] for name in ('gcc_page', 'smmu_base', 'stream_id'))
+    if (board['name'] != 'elden' or board['soc'] != 'SM8750P'
+            or any(type(value) is not int or not 0 < value < (1 << 32) or value % 4096
+                   for value in (host, gcc, smmu))
+            or type(stream) is not int or not 0 < stream <= 0xffff):
+        raise ValueError('invalid Elden UFS handoff profile')
+
+    destination.mkdir(parents=True, exist_ok=True)
+    driver_patches = device / 'scripts/driver-patches'
+    resources = {
+        'NativeUfs.cpp': upstream,
+        'RootCommands.h': upstream.with_name('RootCommands.h'),
+        'RootLayout.h': upstream.with_name('RootLayout.h'),
+        'EldenUfsIdentity.h': driver_patches / 'EldenUfsIdentity.h',
+        'EldenUfsHandoff.h': device / 'soc/sm8750/include/EldenUfsHandoff.h',
+    }
+    for name, path in resources.items():
+        shutil.copyfile(path, destination / name)
+    patch = driver_patches / 'elden-macos26-ufs.patch'
+    subprocess.run(['patch', '--batch', '--fuzz=0', '-p1', '-i', str(patch.resolve())],
+                   cwd=destination, check=True, capture_output=True)
+    profile = destination / 'EldenUfsProfile.h'
+    profile.write_text(f'#define ELDEN_UFS_HOST {host:#x}ULL\n'
+                       f'#define ELDEN_UFS_GCC_PAGE {gcc:#x}ULL\n'
+                       f'#define ELDEN_UFS_SMMU {smmu:#x}ULL\n'
+                       f'#define ELDEN_UFS_STREAM {stream:#x}U\n'
+                       f'#define ELDEN_UFS_INSTALL_FIRST {first}ULL\n'
+                       f'#define ELDEN_UFS_INSTALL_LAST {last}ULL\n')
+    files = {name: hashlib.sha256((destination / name).read_bytes()).hexdigest()
+             for name in (*resources, profile.name, 'EldenUfsExtent.h')}
+    return destination / upstream.name, dict(
+        board='elden', boot_argument='native-ufs-elden=1', read_only=True, inherited_dma=True,
+        legacy_queue=True, patch_sha256=hashlib.sha256(patch.read_bytes()).hexdigest(), files=files,
+        install_extent=dict(boot_argument='elden-ufs-install', read_only_mode=1, write_mode=2,
+                            first_lba=first, last_lba=last, block_bytes=4096))
+
+

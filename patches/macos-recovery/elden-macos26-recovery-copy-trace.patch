+		vnode_putname(name);
+		return;
+	}
+
+	struct cs_blob *blob = ubc_cs_blob_get(imgp->ip_vp, -1, -1, imgp->ip_arch_offset);
+	unsigned long long blob_flags = blob == NULL ? 0 : blob->csb_flags;
+	printf("SHENG-RECOVERY-EXEC: pid=%d ppid=%d name=%s before=%llx new=%x caller=%llx blob=%llx\n",
+	    proc_pid(proc), proc_ppid(proc), name, (unsigned long long)proc_getcsflags(proc),
+	    imgp->ip_csflags, (unsigned long long)proc_getcsflags(current_proc()), blob_flags);
+	const char *key = NULL;
+	if (strcmp(name, "rc_script_wrapper") == 0) {
+		key = "com.apple.rootless.install.heritable";
+	} else if (strcmp(name, "ditto") == 0) {
+		key = "com.apple.rootless.internal-installer-equivalent";
+	}
+	if (blob != NULL && key != NULL) {
+		const void *entitlements = csblob_os_entitlements_get(blob);
+		kern_return_t boolean_status = KERN_NOT_SUPPORTED;
+		if (entitlements != NULL && amfi != NULL &&
+		    amfi->OSEntitlements.version >= OSENTITLEMENTS_INTERFACE_VERSION &&
+		    amfi->OSEntitlements.queryEntitlementBoolean != NULL) {
+			boolean_status = amfi->OSEntitlements.queryEntitlementBoolean(entitlements, key);
+		}
+		printf("SHENG-RECOVERY-ENTITLEMENT: name=%s parsed=%d query=%d boolean-status=%d\n",
+		    name, entitlements != NULL,
+		    IOVnodeHasEntitlement(imgp->ip_vp, imgp->ip_arch_offset, key), boolean_status);
+	}
+	vnode_putname(name);
+}
+#endif

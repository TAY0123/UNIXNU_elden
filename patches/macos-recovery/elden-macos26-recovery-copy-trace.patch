+static __attribute__((noinline)) void
+sheng_trace_ditto_xattr_denial(vfs_context_t context, const char *name,
+    const char *stage)
+{
+	static unsigned failures;
+	proc_t proc = vfs_context_proc(context);
+
+	if (!sheng_pid1_trace_enabled || proc == PROC_NULL ||
+	    strcmp(proc->p_comm, "ditto") != 0 ||
+	    strcmp(name, "com.apple.rootless") != 0 ||
+	    __atomic_fetch_add(&failures, 1, __ATOMIC_RELAXED) >= 48) {
+		return;
+	}
+
+	unsigned csr = 0;
+#if CONFIG_CSR
+	csr_config_t active;
+	if (csr_get_active_config(&active) == 0) {
+		csr = active;
+	}
+#endif
+	printf("SHENG-DITTO-XATTR: pid=%d attr=%s stage=%s csr=%x\n",
+	    proc_pid(proc), name, stage, csr);
+}
+#endif

+static __attribute__((noinline)) void
+sheng_trace_recovery_installer_exec(proc_t proc, const struct image_params *imgp)
+{
+	static unsigned records;
+	const char *name = imgp->ip_vp == NULLVP ? NULL : vnode_getname(imgp->ip_vp);
+	if (name == NULL) {
+		return;
+	}
+	if ((strcmp(name, "rc_script_wrapper") != 0 &&
+	    strcmp(name, "sh") != 0 && strcmp(name, "bash") != 0 &&
+	    strcmp(name, "ditto") != 0) ||
+	    __atomic_fetch_add(&records, 1, __ATOMIC_RELAXED) >= 48) {
+		vnode_putname(name);
+		return;
+	}
+
+	struct cs_blob *blob = ubc_cs_blob_get(imgp->ip_vp, -1, -1, imgp->ip_arch_offset);
+	unsigned long long blob_flags = blob == NULL ? 0 : blob->csb_flags;
+	printf("SHENG-RECOVERY-EXEC: pid=%d ppid=%d name=%s before=%llx new=%x caller=%llx blob=%llx\n",
+	    proc_pid(proc), proc_ppid(proc), name, (unsigned long long)proc_getcsflags(proc),
+	    imgp->ip_csflags, (unsigned long long)proc_getcsflags(current_proc()), blob_flags);
+	const char *key = NULL;
+	if (strcmp(name, "rc_script_wrapper") == 0) {
+		key = "com.apple.rootless.install.heritable";
+	} else if (strcmp(name, "ditto") == 0) {
+		key = "com.apple.rootless.internal-installer-equivalent";
+	}
+	if (blob != NULL && key != NULL) {
+		printf("SHENG-RECOVERY-ENTITLEMENT: name=%s parsed=%d query=%d\n", name,
+		    csblob_os_entitlements_get(blob) != NULL,
+		    IOVnodeHasEntitlement(imgp->ip_vp, imgp->ip_arch_offset, key));
+	}
+	vnode_putname(name);
+}
+#endif

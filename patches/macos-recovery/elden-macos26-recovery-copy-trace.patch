--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -41,6 +41,24 @@
 extern void dtrace_systrace_syscall_return(unsigned short, int, int *);
 #endif  /* CONFIG_DTRACE */
 
+#if SHENG
+extern unsigned sheng_pid1_trace_enabled;
+
+static __attribute__((noinline)) void
+sheng_trace_ditto_denial(proc_t proc, unsigned code, uint64_t flags)
+{
+	static unsigned failures;
+	if (strcmp(proc->p_comm, "ditto") != 0 ||
+	    __atomic_fetch_add(&failures, 1, __ATOMIC_RELAXED) >= 48) {
+		return;
+	}
+	printf("SHENG-DITTO: pid=%d syscall=%u error=%d\n", proc_pid(proc), code, EPERM);
+	if (code == SYS_chflags || code == SYS_fchflags) {
+		printf("SHENG-DITTO: file-flags=%llx\n", (unsigned long long)flags);
+	}
+}
+#endif
+
 extern void
 unix_syscall(struct arm_saved_state * regs, thread_t thread_act, struct proc * proc);
 
@@ -185,6 +203,12 @@
 skip_syscall:
 #endif /* CONFIG_MACF */
 
+#if SHENG
+	if (__improbable(error == EPERM && sheng_pid1_trace_enabled)) {
+		sheng_trace_ditto_denial(proc, syscode, uthread->uu_arg[1]);
+	}
+#endif
+
 	unix_syscall_kprintf("code %d, error %d, results %x, %x (pid %d - %s, tid %lld)\n", code, error,
 	    uthread->uu_rval[0], uthread->uu_rval[1],
 	    pid, get_bsdtask_info(current_task()) ? proc->p_comm : "unknown", thread_tid(current_thread()));

diff --git a/pexpert/arm/pe_kprintf.c b/pexpert/arm/pe_kprintf.c
index 0e5a3ca..164b11d 100644
--- a/pexpert/arm/pe_kprintf.c
+++ b/pexpert/arm/pe_kprintf.c
@@ -32,8 +32,16 @@ uint64_t sheng_boot_progress_seconds(void)
 }
 static __attribute__((noreturn)) void sheng_boot_progress_thread(__unused void *argument, __unused wait_result_t result)
 {
+	uint64_t next_pid1_report = 0;
 	for (;;) {
 		sheng_boot_progress_tick();
+		if (sheng_pid1_trace_enabled) {
+			uint64_t now = sheng_boot_progress_seconds();
+			if (now >= next_pid1_report) {
+				sheng_pid1_trace_report();
+				next_pid1_report = now + 30;
+			}
+		}
 		assert_wait_timeout((event_t)&sheng_boot_progress_enabled, THREAD_UNINT, 2, NSEC_PER_SEC);
 		thread_block(THREAD_CONTINUE_NULL);
 	}
@@ -44,6 +52,9 @@ void sheng_boot_progress_start(void)
 	uint32_t expected = 0;
 	if (!sheng_boot_progress_enabled || !__atomic_compare_exchange_n(&started, &expected, 1,
 	    0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return;
+	unsigned pid1_trace = 0;
+	PE_parse_boot_argn("sheng-pid1-trace", &pid1_trace, sizeof(pid1_trace));
+	sheng_pid1_trace_enabled = pid1_trace == 1;
 	thread_t thread;
 	if (kernel_thread_start(sheng_boot_progress_thread, NULL, &thread) == KERN_SUCCESS)
 		thread_deallocate(thread);

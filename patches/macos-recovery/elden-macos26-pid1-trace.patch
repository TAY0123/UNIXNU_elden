+#if SHENG
+extern int proc_selfpid(void);
+unsigned sheng_pid1_trace_enabled;
+unsigned sheng_pid1_exec_returned, sheng_pid1_main_ack;
+static uint64_t sheng_pid1_el0_sync, sheng_pid1_svc, sheng_pid1_last_esr;
+static int sheng_pid1_last_svc;
+
+struct sheng_pid1_sample {
+	uint64_t entered;
+	uint64_t completed;
+	uint64_t pc;
+	uint64_t far;
+	uint64_t lr;
+	uint64_t esr;
+	int code;
+	int result;
+};
+
+static bool sheng_pid1_sampling;
+static struct sheng_pid1_sample sheng_pid1_ifault, sheng_pid1_syscall;
+
+static uint64_t
+sheng_pid1_begin(struct sheng_pid1_sample *sample, arm_saved_state_t *state,
+    int code, uint64_t esr, vm_offset_t far)
+{
+	if (__atomic_test_and_set(&sheng_pid1_sampling, __ATOMIC_ACQUIRE)) {
+		return 0;
+	}
+	uint64_t ticket = ++sample->entered;
+	sample->pc = get_saved_state_pc(state);
+	sample->lr = get_saved_state_lr(state);
+	sample->esr = esr;
+	sample->far = far;
+	sample->code = code;
+	sample->result = -1;
+	__atomic_clear(&sheng_pid1_sampling, __ATOMIC_RELEASE);
+	return ticket;
+}
+
+static void
+sheng_pid1_finish(struct sheng_pid1_sample *sample, uint64_t ticket, int result)
+{
+	if (ticket == 0 || __atomic_test_and_set(&sheng_pid1_sampling, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	sample->completed++;
+	if (sample->entered == ticket) {
+		sample->result = result;
+	}
+	__atomic_clear(&sheng_pid1_sampling, __ATOMIC_RELEASE);
+}
+
+/* Capture never logs or waits. Print only from the boot progress worker. */
+void
+sheng_pid1_trace_report(void)
+{
+	printf("SHENG-PID1: exec-return=%u el0-sync=%llu svc=%llu last-svc=%d last-esr=%llx main=%u\n",
+	    __atomic_load_n(&sheng_pid1_exec_returned, __ATOMIC_RELAXED),
+	    (unsigned long long)__atomic_load_n(&sheng_pid1_el0_sync, __ATOMIC_RELAXED),
+	    (unsigned long long)__atomic_load_n(&sheng_pid1_svc, __ATOMIC_RELAXED),
+	    __atomic_load_n(&sheng_pid1_last_svc, __ATOMIC_RELAXED),
+	    (unsigned long long)__atomic_load_n(&sheng_pid1_last_esr, __ATOMIC_RELAXED),
+	    __atomic_load_n(&sheng_pid1_main_ack, __ATOMIC_RELAXED));
+
+	if (__atomic_test_and_set(&sheng_pid1_sampling, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	struct sheng_pid1_sample fault = sheng_pid1_ifault;
+	struct sheng_pid1_sample syscall = sheng_pid1_syscall;
+	__atomic_clear(&sheng_pid1_sampling, __ATOMIC_RELEASE);
+	if (fault.entered != 0) {
+		printf("SHENG-PID1-IF: done=%llu/%llu vm=%d esr=%llx\n",
+		    (unsigned long long)fault.completed, (unsigned long long)fault.entered,
+		    fault.result, (unsigned long long)fault.esr);
+		printf("SHENG-PID1-IF: pc=%llx far=%llx lr=%llx\n",
+		    (unsigned long long)fault.pc, (unsigned long long)fault.far,
+		    (unsigned long long)fault.lr);
+	}
+	if (syscall.entered != 0) {
+		printf("SHENG-PID1-SVC: done=%llu/%llu code=%d errno=%d pc=%llx\n",
+		    (unsigned long long)syscall.completed, (unsigned long long)syscall.entered,
+		    syscall.code, syscall.result, (unsigned long long)syscall.pc);
+	}
+}
+#endif
+
 
 

+/*
+ * Install only the affected map granules over the original executable
+ * mapping. The shared-region pager validates the untouched source pages
+ * and applies the rules to its own pages after copying them.
+ */
+static kern_return_t
+elden_map_recovery_graphics(
+	vm_shared_region_t shared_region,
+	vm_map_t map,
+	int file_count,
+	struct _sr_file_mappings *files)
+{
+	if (elden_recovery_software_display != 1 || PAGE_SIZE != SHENG_UI_PAGE_BYTES) {
+		return KERN_SUCCESS;
+	}
+	bool allowed = PE_vmm_present == 1 ? csr_check(CSR_ALLOW_UNAUTHENTICATED_ROOT) == 0 :
+	    elden_recovery_is_authenticated_ufs();
+	if (!allowed) {
+		return KERN_PROTECTION_FAILURE;
+	}
+
+	vm_map_size_t size = VM_MAP_PAGE_SIZE(map);
+	if (size != PAGE_SIZE && size != 16384) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	size_t installed = 0;
+	for (int i = 0; i < file_count; i++) {
+		struct _sr_file_mappings *file = &files[i];
+		if (file->vp == NULL || file->file_control == NULL) {
+			continue;
+		}
+		const char *name = vnode_getname(file->vp);
+		if (name == NULL) {
+			continue;
+		}
+		bool match = strcmp(name, sheng_ui_pages[0].file) == 0;
+		vnode_putname(name);
+		if (!match) {
+			continue;
+		}
+		vm_object_t backing = memory_object_control_to_vm_object(file->file_control);
+		if (backing == VM_OBJECT_NULL || !backing->code_signed) {
+			return KERN_PROTECTION_FAILURE;
+		}
+		for (size_t r = 0; r < sizeof(sheng_ui_pages) / sizeof(sheng_ui_pages[0]); r++) {
+			uint64_t offset = sheng_ui_pages[r].file_offset & ~(size - 1);
+			for (uint32_t m = 0; m < file->mappings_count; m++) {
+				const struct shared_file_mapping_slide_np *mapping = &file->mappings[m];
+				if (!(mapping->sms_init_prot & VM_PROT_EXECUTE) ||
+				    (mapping->sms_max_prot & (VM_PROT_WRITE | VM_PROT_SLIDE | VM_PROT_ZF)) ||
+				    offset < mapping->sms_file_offset || size > mapping->sms_size ||
+				    offset - mapping->sms_file_offset > mapping->sms_size - size) {
+					continue;
+				}
+				vm_map_offset_t address = mapping->sms_address - shared_region->sr_base_address +
+				    offset - mapping->sms_file_offset;
+				if (address & (size - 1)) {
+					return KERN_INVALID_ARGUMENT;
+				}
+				/* A null slide record selects copying with Elden's graphics rules. */
+				memory_object_t pager = shared_region_pager_setup(backing, offset, NULL, 0);
+				if (pager == MEMORY_OBJECT_NULL) {
+					return KERN_RESOURCE_SHORTAGE;
+				}
+				vm_map_kernel_flags_t flags = VM_MAP_KERNEL_FLAGS_FIXED(.vmf_overwrite = true);
+				flags.vmkf_overwrite_immutable = true;
+				flags.vmkf_no_copy_on_read = true;
+				flags.vmf_permanent = shared_region_make_permanent(shared_region, mapping->sms_max_prot);
+				kern_return_t kr = mach_vm_map_kernel(map, vm_sanitize_wrap_addr_ref(&address),
+				    size, 0, flags, (ipc_port_t)(uintptr_t)pager, 0, TRUE,
+				    mapping->sms_init_prot & VM_PROT_ALL, mapping->sms_max_prot & VM_PROT_ALL,
+				    VM_INHERIT_DEFAULT);
+				memory_object_deallocate(pager);
+				if (kr != KERN_SUCCESS) {
+					return kr;
+				}
+				installed++;
+				break;
+			}
+		}
+		if (installed != sizeof(sheng_ui_pages) / sizeof(sheng_ui_pages[0])) {
+			return KERN_INVALID_ARGUMENT;
+		}
+		break;
+	}
+	if (installed) {
+		printf("ELDEN-GRAPHICS: installed %zu private cache mappings (%llu bytes each)\n",
+		    installed, (unsigned long long)size);
+	}
+	return KERN_SUCCESS;
+}

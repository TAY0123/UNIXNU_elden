+/* The reference Language Chooser probe is disabled in this display build. */
+uint32_t sheng_recovery_ui_enabled;
+volatile uint32_t sheng_recovery_ui_pages_applied;
+volatile uint32_t sheng_recovery_ui_page_mask;
+
+static void
+elden_graphics_digest(const void *bytes, size_t size, uint8_t digest[32])
+{
+	SHA256_CTX context;
+	SHA256_Init(&context);
+	SHA256_Update(&context, bytes, size);
+	SHA256_Final(digest, &context);
+}
+
+static kern_return_t
+elden_graphics_page(vm_offset_t source_va, ppnum_t target, vm_offset_t target_va,
+    vm_object_offset_t offset)
+{
+	memcpy((void *)target_va, (const void *)source_va, PAGE_SIZE);
+	for (size_t i = 0; i < sizeof(sheng_ui_pages) / sizeof(sheng_ui_pages[0]); i++) {
+		const struct sheng_ui_page *rule = &sheng_ui_pages[i];
+		if (rule->file_offset != offset) {
+			continue;
+		}
+		if (sheng_ui_apply_page((uint8_t *)target_va, PAGE_SIZE, rule, elden_graphics_digest) != 1) {
+			return KERN_PROTECTION_FAILURE;
+		}
+		cache_sync_page(target);
+		uint32_t bit = 1u << i;
+		if (!(__atomic_fetch_or(&sheng_recovery_ui_page_mask, bit, __ATOMIC_RELAXED) & bit)) {
+			__atomic_add_fetch(&sheng_recovery_ui_pages_applied, 1, __ATOMIC_RELAXED);
+			printf("ELDEN-GRAPHICS: authenticated private cache page %zu\n", i);
+		}
+		break;
+	}
+	return KERN_SUCCESS;
+}
 

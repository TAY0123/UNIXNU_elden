--- /dev/null
+++ b/probes/el1-native/EldenPac.c
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: MIT
+#include "NativeEl1.h"
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+
+extern UINT64 ShengEl1PauthProbe(UINT64 *Signatures, UINT64 *Trap, UINTN Progress, UINTN Stride);
+
+EFI_STATUS EFIAPI
+UefiMain(EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable)
+{
+  UINT64 El, Isar1, Isar2, SpSel, Flags;
+  UINT64 Signatures[10] = {0};
+  UINT64 Trap[3] = {0};
+  UINTN Progress = 0, Stride = 0;
+
+  (VOID)ImageHandle;
+  (VOID)SystemTable;
+  gST->ConOut->ClearScreen(gST->ConOut);
+  __asm__ volatile("mrs %0,CurrentEL" : "=r"(El));
+  Print(L"ELDEN-PAC: EL=%lu - key switching and restoration\r\n", El >> 2);
+  if (El != 4) {
+    return ShengProbeFinish(EFI_UNSUPPORTED);
+  }
+  __asm__ volatile("mrs %0,id_aa64isar1_el1; mrs %1,id_aa64isar2_el1; mrs %2,spsel"
+                   : "=r"(Isar1), "=r"(Isar2), "=r"(SpSel));
+  Print(L"ELDEN-PAC: ISAR1=%lx ISAR2=%lx\r\n", Isar1, Isar2);
+  if (SpSel != 1 || (!(Isar1 & 0xff0) && !(Isar2 & 0xf000)) ||
+      (!(Isar1 & 0xff000000) && !(Isar2 & 0xf00))) {
+    Print(L"ELDEN-PAC: requires SP_EL1 and advertised address and generic PAC\r\n");
+    return ShengProbeFinish(EFI_UNSUPPORTED);
+  }
+  if (EFI_ERROR(ShengProbePrepareProgress(&Progress, &Stride))) {
+    Progress = 0;
+  }
+  ShengProbePause(L"Press a key to run the EL1 PAC probe");
+  Print(L"ELDEN-PAC: starting. Record the last marker if the probe stops.\r\n");
+  Flags = ShengEl1PauthProbe(Signatures, Trap, Progress, Stride);
+  Print(L"ELDEN-PAC: bank-switch=%s flags=%lx expected=7FFF\r\n",
+        Flags == 0x7fff ? L"PASS" : L"FAIL", Flags);
+  if (Trap[0]) {
+    Print(L"ELDEN-PAC: trap checkpoint=%lu ESR=%lx ELR=%lx\r\n",
+          Trap[0], Trap[1], Trap[2]);
+  }
+  return ShengProbeFinish(Flags == 0x7fff && !Trap[0] ? EFI_SUCCESS : EFI_DEVICE_ERROR);
+}

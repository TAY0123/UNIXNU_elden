+BOOLEAN
+UniXNUSerialAvailable (
+  VOID
+  )
+{
+  return mSerial != NULL;
+}
+
+BOOLEAN
+UniXNUSerialReadByte (
+  OUT CHAR8  *Byte
+  )
+{
+  UINT32  Control;
+  UINTN   Size;
+
+  if ((mSerial == NULL) ||
+      EFI_ERROR (mSerial->GetControl (mSerial, &Control)) ||
+      ((Control & EFI_SERIAL_INPUT_BUFFER_EMPTY) != 0))
+  {
+    return FALSE;
+  }
+
+  Size = 1;
+  return !EFI_ERROR (mSerial->Read (mSerial, &Size, Byte)) && (Size == 1);
+}
+

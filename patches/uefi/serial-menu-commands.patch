+STATIC
+BOOLEAN
+SerialCommand (
+  IN CONST CHAR8         *Line,
+  IN CONST UNIXNU_CONFIG *Config,
+  IN UINTN               Selected,
+  OUT UINTN              *BootIndex
+  )
+{
+  UINTN              Index;
+  UINTN              Match;
+  CONST UNIXNU_ENTRY *Entry;
+
+  if (AsciiStrCmp (Line, "help") == 0) {
+    UniXNULog ("tty: help | list | status | boot <id>");
+    return TRUE;
+  }
+
+  if (AsciiStrCmp (Line, "status") == 0) {
+    UniXNULog ("tty: selected=%u default=%u entries=%u", (UINT32)Selected,
+               (UINT32)Config->DefaultIndex, (UINT32)Config->EntryCount);
+    return TRUE;
+  }
+
+  if (AsciiStrCmp (Line, "list") == 0) {
+    for (Index = 0; Index < Config->EntryCount; Index++) {
+      Entry = &Config->Entries[Index];
+      UniXNULog ("tty: entry %u id=%a %s%a", (UINT32)Index,
+                 Entry->Id != NULL ? Entry->Id : "?", Entry->Title,
+                 Entry->Confirm != NULL ? " [local confirmation]" : "");
+    }
+
+    return TRUE;
+  }
+
+  if ((AsciiStrnCmp (Line, "boot ", 5) != 0) || (Line[5] == '\0')) {
+    UniXNULog ("tty: unknown command, type help");
+    return FALSE;
+  }
+
+  Match = MAX_UINTN;
+  for (Index = 0; Index < Config->EntryCount; Index++) {
+    Entry = &Config->Entries[Index];
+    if ((Entry->Id == NULL) || (AsciiStrCmp (Line + 5, Entry->Id) != 0)) {
+      continue;
+    }
+
+    if (Match != MAX_UINTN) {
+      UniXNULog ("tty: ambiguous entry ID");
+      return FALSE;
+    }
+
+    Match = Index;
+  }
+
+  if (Match == MAX_UINTN) {
+    UniXNULog ("tty: entry ID not found");
+    return FALSE;
+  }
+
+  if (Config->Entries[Match].Confirm != NULL) {
+    UniXNULog ("tty: entry requires local confirmation");
+    return TRUE;
+  }
+
+  UniXNULog ("tty: booting %a", Config->Entries[Match].Id);
+  *BootIndex = Match;
+  return TRUE;
+}
+
+typedef struct {
+  CHAR8    Bytes[SERIAL_LINE_BYTES];
+  UINTN    Length;
+  BOOLEAN  Invalid;
+} SERIAL_LINE;
+
+STATIC
+BOOLEAN
+PollSerial (
+  IN OUT SERIAL_LINE          *Line,
+  IN CONST UNIXNU_CONFIG      *Config,
+  IN UINTN                    Selected,
+  OUT UINTN                   *BootIndex
+  )
+{
+  UINTN    Index;
+  CHAR8    Byte;
+  BOOLEAN  Active;
+
+  Active = FALSE;
+  for (Index = 0; Index < SERIAL_POLL_BYTES && UniXNUSerialReadByte (&Byte); Index++) {
+    if ((Byte == '\r') || (Byte == '\n')) {
+      if (Line->Invalid) {
+        UniXNULog ("tty: invalid or overlong command");
+      } else if (Line->Length != 0) {
+        Line->Bytes[Line->Length] = '\0';
+        Active = SerialCommand (Line->Bytes, Config, Selected, BootIndex) || Active;
+      }
+
+      Line->Length = 0;
+      Line->Invalid = FALSE;
+      if (*BootIndex != MAX_UINTN) {
+        break;
+      }
+    } else if (Line->Invalid) {
+      continue;
+    } else if ((Byte == 8) || (Byte == 127)) {
+      if (Line->Length != 0) {
+        Line->Length--;
+      }
+    } else if ((Byte < 32) || (Byte > 126) || (Line->Length == sizeof (Line->Bytes) - 1)) {
+      Line->Invalid = TRUE;
+    } else {
+      Line->Bytes[Line->Length++] = Byte;
+    }
+  }
+
+  return Active;
+}

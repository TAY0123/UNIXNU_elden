diff --git a/package/UniXNUPkg/Library/UniXNULib/Boot.c b/package/UniXNUPkg/Library/UniXNULib/Boot.c
index 4b1e737..8ef2f4d 100644
--- a/package/UniXNUPkg/Library/UniXNULib/Boot.c
+++ b/package/UniXNUPkg/Library/UniXNULib/Boot.c
@@ -10,6 +10,38 @@
 #include <Guid/Fdt.h>
 #include <Protocol/UniXNULoader.h>
 
+#if defined (MDE_CPU_AARCH64)
+#include <IndustryStandard/ArmStdSmc.h>
+#include <Library/ArmSmcLib.h>
+
+// Elden's bootloader target for PSCI SYSTEM_RESET2.
+#define ELDEN_RESET_TYPE_BOOTLOADER  0x80010001U
+#define ELDEN_RESET_COOKIE_FASTBOOT   0x2U
+
+STATIC
+EFI_STATUS
+RebootFastboot (
+  VOID
+  )
+{
+  ARM_SMC_ARGS  Args = { 0 };
+
+  Args.Arg0 = ARM_SMC_ID_PSCI_SYSTEM_RESET2_AARCH64;
+  Args.Arg1 = ELDEN_RESET_TYPE_BOOTLOADER;
+  Args.Arg2 = ELDEN_RESET_COOKIE_FASTBOOT;
+  UniXNULog ("action: reboot to fastboot");
+  ArmCallSmc (&Args);
+
+  // A successful reset does not return.
+  UniXNULog ("action: fastboot reset returned %d", (INT32)Args.Arg0);
+  if ((INT32)Args.Arg0 == ARM_SMC_PSCI_RET_NOT_SUPPORTED) {
+    return EFI_UNSUPPORTED;
+  }
+
+  return EFI_DEVICE_ERROR;
+}
+#endif
+
 STATIC
 EFI_STATUS
 RunAction (
@@ -21,6 +53,10 @@ RunAction (
       UniXNULog ("action: reset");
       gRT->ResetSystem (EfiResetCold, EFI_SUCCESS, 0, NULL);
       break;
+#if defined (MDE_CPU_AARCH64)
+    case UniXNUActionFastboot:
+      return RebootFastboot ();
+#endif
     case UniXNUActionShutdown:
       UniXNULog ("action: shutdown");
       gRT->ResetSystem (EfiResetShutdown, EFI_SUCCESS, 0, NULL);
